---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import StoryContent from "@/components/StoryContent";


const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => ({
        params: { slug: project.data.slug },
        props: { project },
    }));
}

const { project } = Astro.props;
---

<Layout>
    <section class="project-hero position-relative text-white">
        <!-- Fondo -->
        <div
            class="hero-bg"
            style={`background-image: url(${base}images/${project.data.image});`}
        >
        </div>

        <!-- Overlay glass -->
        <div class="hero-overlay"></div>

        <!-- Contenido -->
        <div
            class="container h-100 d-flex flex-column justify-content-between py-4"
        >
            <!-- HEADER -->
            <div class="mb-3">
                <h1 class="fw-bold display-12">{project.data.title}</h1>
                <span class="badge bg-light text-dark">{project.data.role}</span
                >
            </div>

            <div>
                <StoryContent client:load project={project} />
            </div>
        </div>
    </section>

    <style>
        .project-hero {
            height: 100vh;
            position: relative;

            /* 🔥 esto elimina el corte */
            margin-top: -80px; /* ajusta según altura real del header */
            padding-top: 80px;
        }

        .hero-bg {
            position: absolute;
            top: 0;
            right: 0;
            height: 100%;

            /* 🔥 controla cuánto ocupa */
            width: 40%;

            background-size: cover;
            background-position: center right;
            background-repeat: no-repeat;

            filter: brightness(0.6);

            /* 🔥 difuminado hacia la izquierda */
            -webkit-mask-image: linear-gradient(
                to left,
                rgba(0, 0, 0, 1) 30%,
                rgba(0, 0, 0, 0.6) 50%,
                rgba(0, 0, 0, 0) 70%
            );
            mask-image: linear-gradient(
                to left,
                rgba(0, 0, 0, 0.8) 60%,
                rgba(0, 0, 0, 0.3) 80%,
                rgba(0, 0, 0, 0) 100%
            );

            z-index: 0;
        }

        /* Glass overlay */
        .hero-overlay {
            position: absolute;
            inset: 0;

            background: rgba(0, 0, 0, 0.1);
            z-index: 1;
        }

        /* Contenido encima */
        .project-hero .container {
            position: relative;
            z-index: 2;
        }

        @media (max-width: 768px) {
            .project-hero {
                height: auto;
                margin-top: 0;
                padding-top: 0;
                padding-bottom: 2rem;
            }

            .hero-bg {
                position: relative;
                width: 100%;
                height: 38vh; /* 🔥 control principal */

                background-position: center;
                background-size: cover;
                background-repeat: no-repeat;

                filter: brightness(0.9);
                margin-bottom: 1rem;

                /* 🔥 fade desde la mitad hacia abajo */
                -webkit-mask-image: linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 1) 50%,
                    rgba(0, 0, 0, 0.6) 70%,
                    rgba(0, 0, 0, 0) 100%
                );
                mask-image: linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 1) 50%,
                    rgba(0, 0, 0, 0.6) 70%,
                    rgba(0, 0, 0, 0) 100%
                );
            }

            .hero-bg::after {
                content: "";
                position: absolute;
                inset: 0;

                background: linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 0) 40%,
                    rgba(0, 0, 0, 0.4) 75%,
                    rgba(0, 0, 0, 0.7) 100%
                );

                pointer-events: none;
            }

            .hero-overlay {
                display: none;
            }

            .project-hero .container {
                justify-content: flex-start !important;
                gap: 1rem;
            }
        }
    </style>
</Layout>

---
import LayoutCover from "../layouts/LayoutCover.astro";
import avatar from "../assets/avatar.png";
---

<LayoutCover>
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- LEFT -->
            <div class="col-12 col-lg-6 text-center text-lg-start">
                <h1 class="display-4 fw-bold mb-3">
                    Hola Mundo,<br />soy
                    <span class="gradient-text">Luis F</span>.
                </h1>

                <p class="lead text-white-50 mb-4">
                    Desarrollador de sistemas web. Me apasiona crear soluciones tecnológicas que optimizan procesos y mejoran la experiencia del usuario.
                </p>

                <div
                    class="d-flex gap-3 justify-content-center justify-content-lg-start"
                >
                    <button
                        class="btn btn-lg btn-gradient fw-semibold"
                        id="contactToggle"
                        aria-expanded="false">
                        Contactarme
                    </button>

                    <a href="about" class="btn btn-lg btn-outline-neon">
                        Saber más
                    </a>
                </div>

            <!-- CONTACT OPTIONS -->
                <div
                    id="contactOptions"
                    class="contact-options d-flex gap-3 justify-content-center justify-content-lg-start py-3"
                >
                    <a href="mailto:luisfh007@gmail.com" class="contact-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-fill" viewBox="0 0 16 16">
                        <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"/>
                        </svg>
                    </a>

                    <a href="https://www.linkedin.com/in/luis-felipe-valencia-hernandez/" target="_blank" class="contact-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-linkedin" viewBox="0 0 16 16">
                        <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
                        </svg>
                    </a>

                    <a href="tel:+5219933743023" class="contact-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-12 col-lg-6 text-center hero-right">
                <div class="hero-illustration">
                    <!-- Placeholder -->
                    <div class="illustration-glow"></div>
                    <img
                        src={avatar.src}
                        alt="Avatar"
                        class="hero-avatar"
                    />
                </div>
            </div>
        </div>
    </div>

    <style>
        /* Gradient text */
        .gradient-text {
            background: linear-gradient(90deg,rgba(191, 255, 0, 0.6), #bfff00);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .btn-gradient {
        background: linear-gradient(90deg, rgba(191, 255, 0, 0.6), #BFFF00);
        border: none;
        color: #000; // mejor contraste con verde neón
        transition: all 0.3s ease;
        }

        .btn-gradient:hover {
        opacity: 0.9;
        box-shadow: 0 0 12px rgba(191, 255, 0, 0.6);
        }

        .btn-outline-neon {
        border: 1px solid rgba(191, 255, 0, 0.4);
        color: #BFFF00;
        background: transparent;

        transition: all 0.25s ease;
        }

        .btn-outline-neon:hover {
        background: rgba(191, 255, 0, 0.1);
        box-shadow: 0 0 10px rgba(191, 255, 0, 0.4);
        }

        /* Illustration glow */
        .hero-illustration {
            position: relative;
        }

        .illustration-glow {
        position: absolute;
        width: 250px;
        height: 250px;
        background: radial-gradient(
            circle,
            #BFFF00,
            transparent
        );
        filter: blur(60px);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
        }

        /* Avatar EN FRENTE */
        .hero-avatar {
            position: relative;
            z-index: 2; /*delante del glow */

            height: 100vh; /* ocupa todo el alto */
            max-height: 500px; /* evita que explote en pantallas gigantes */
            aspect-ratio: 1 / 1; /* fuerza proporción cuadrada */
            object-fit: cover;   /* evita deformaciones */

            /* opcional: mejora estética */
            filter: drop-shadow(0 10px 30px rgba(0,0,0,0.6));
        }

        /* RIGHT HERO */
        .hero-right {
            height: 100%;
        }

        /* Contenedor principal */
        .hero-illustration {
            position: relative;
            height: 100%;
            min-height: 70vh; /* fallback en mobile */
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .contact-options {
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;

        transition: all 0.3s ease;
        }

        /* estado visible */
        .contact-options.show {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
        }

        /* iconos */
        .contact-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        text-decoration: none;

        background: rgba(255, 255, 255, 0);
        color: #BFFF00;

        border: 1px solid rgba(191, 255, 0, 0.2);

        transition: all 0.25s ease;
        }

        .contact-icon:hover {
        background: rgba(191, 255, 0, 0.2);
        box-shadow: 0 0 10px rgba(191, 255, 0, 0.5);
        transform: translateY(-2px);
        }

        /* Solo móviles */
        @media (max-width: 768px) {
            .hero-avatar {
                max-width: 350px;
                width: 100%;
                height: auto; /* 🔥 clave para mobile */
            }
        }
    </style>

    <script>
        const btn = document.getElementById('contactToggle');
        const panel = document.getElementById('contactOptions');

        btn?.addEventListener('click', () => {
            if (panel) {
                const isOpen = panel.classList.toggle('show');
                btn.setAttribute('aria-expanded', isOpen.toString());
            }
        });
    </script>
</LayoutCover>

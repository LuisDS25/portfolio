---
import "../styles/main.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href={`${base}icons/logo.png`} />
        <title>LefDev</title>

        <!-- Slot para sobrescribir o añadir metadatos específicos -->
        <slot name="head" />
    </head>
    <body class="cover-container d-flex flex-column min-vh-100 text-white">
        <Header />

        <main class="flex-grow-1 d-flex align-items-center px-3">
            <slot />
        </main>

        <!-- Importación del JS de Bootstrap -->
        <script>
            import "bootstrap/dist/js/bootstrap.bundle.min.js";
        </script>
    </body>

    <style>
        body {
            background: #191919;
            font-family: "Inter", sans-serif;
        }
    </style>
</html>

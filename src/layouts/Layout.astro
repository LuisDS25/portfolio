---
import "../styles/main.scss";
import Header from "../components/Header.astro";
import "../styles/story-content.css";
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${base}icons/logo.png`} />
		<title>LefDev</title>

		<!-- Slot para sobrescribir o añadir metadatos específicos -->
		<slot name="head" />
	</head>
	<body class="d-flex flex-column h-100 text-bg-dark">
		<Header />

		<main class="flex-shrink-0">
			<slot />
		</main>

		<!-- Importación del JS de Bootstrap -->
		<script>
			import "bootstrap/dist/js/bootstrap.bundle.min.js";
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background-color: #191919;

		background-image:
			radial-gradient(
				circle at 20% 30%,
				rgba(191, 255, 0, 0.08),
				transparent 25%
			),
			radial-gradient(
				circle at 80% 20%,
				rgba(191, 255, 0, 0.06),
				transparent 25%
			),
			radial-gradient(
				circle at 70% 80%,
				rgba(191, 255, 0, 0.05),
				transparent 30%
			),
			radial-gradient(
				circle at 10% 75%,
				rgba(191, 255, 0, 0.07),
				transparent 25%
			);

		background-repeat: no-repeat;
		background-size: cover;
		font-family: "Inter", sans-serif;
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;

		background: radial-gradient(
			circle at 50% 50%,
			rgba(191, 255, 0, 0.05),
			transparent 60%
		);

		filter: blur(80px);
		z-index: -1;
	}
</style>
